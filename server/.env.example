# Database
# Локальная разработка: укажите своего пользователя PostgreSQL.
DATABASE_URL="postgresql://USER@localhost:5432/adapted_russia_dev?schema=public"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Configuration
PORT=3003
NODE_ENV=development

# Client URL (for CORS and redirects)
CLIENT_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_FROM="AdaptEd Russia <noreply@your-domain.com>"
EMAIL_REPLY_TO="support@your-domain.com"
EMAIL_REQUEST_TIMEOUT_MS=10000
EMAIL_MAX_RETRIES=2

# YooKassa Configuration
# Тестовый магазин: https://yookassa.ru/developers/payment-acceptance/testing-and-going-live/testing
YOOKASSA_SHOP_ID="your-yookassa-shop-id"
YOOKASSA_SECRET_KEY="your-yookassa-secret-key"
# Без ключей или YOOKASSA_USE_MOCK=true → локальный mock (только ADMIN / PAYMENT_TEST_EMAILS)
# YOOKASSA_USE_MOCK=true
# Секрет в URL webhook: https://api.../api/payments/webhook?secret=...
# YOOKASSA_WEBHOOK_SECRET="random-long-string"
# Emails через запятую, которым разрешён mock-checkout
# PAYMENT_TEST_EMAILS="you@example.com"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600

# DeepSeek AI Configuration
# Получите API ключ на https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Reminder notifications (email via Resend above). Telegram optional.
# TELEGRAM_BOT_TOKEN="123456:ABC"
# REMINDER_CRON=true
# REMINDER_CRON_MS=60000
