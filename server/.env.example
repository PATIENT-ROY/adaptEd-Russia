# Database
# Локальная разработка: укажите своего пользователя PostgreSQL.
DATABASE_URL="postgresql://USER@localhost:5432/adapted_russia_dev?schema=public"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Configuration
PORT=3003
NODE_ENV=development

# Client URL (for CORS and redirects)
CLIENT_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxx"
# On NetAngels use address only (no spaces): noreply@adaptedrussia.ru
EMAIL_FROM="AdaptEd Russia <noreply@your-domain.com>"
EMAIL_REPLY_TO="support@your-domain.com"
EMAIL_REQUEST_TIMEOUT_MS=10000
EMAIL_MAX_RETRIES=2

# YooKassa Configuration
YOOKASSA_SHOP_ID="your-yookassa-shop-id"
YOOKASSA_SECRET_KEY="your-yookassa-secret-key"

# For testing, you can use YooKassa sandbox credentials
# Get them from: https://yookassa.ru/developers/using-api/testing
# Mock checkout / test-data / apply-premium: ADMIN or these emails. Comma-separated.
# PAYMENT_TEST_EMAILS=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600

# DeepSeek AI Configuration
# Получите API ключ на https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Notes AI parse quota is OFF unless all three are set. Do not enable without product sign-off.
# AI_NOTES_PARSE_QUOTA=true
# AI_NOTES_PARSE_DAILY_FREEMIUM=
# AI_NOTES_PARSE_DAILY_PREMIUM=

# Reminder notifications (email via Resend above). Telegram optional.
# TELEGRAM_BOT_TOKEN="123456:ABC"
# TELEGRAM_BOT_USERNAME="AdaptEdRussiaBot"
# TELEGRAM_WEBHOOK_URL="https://api.adaptedrussia.ru/api/telegram/webhook"
# TELEGRAM_WEBHOOK_SECRET="replace_with_random_A-Za-z0-9_-"
# TELEGRAM_SET_WEBHOOK=true
# REMINDER_CRON=true
# REMINDER_CRON_MS=60000
# Notify this many hours before dueDate (default 24).
# REMINDER_LEAD_HOURS=24 
