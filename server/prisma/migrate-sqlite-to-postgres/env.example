# One-shot SQLite → PostgreSQL migration (do NOT commit real secrets)

# SQLite source (keep existing file; do not delete).
# Run all commands from server/ — relative file: paths resolve against cwd.
SQLITE_DATABASE_URL="file:./prisma/dev.db"

# Or use the backup:
# SQLITE_DATABASE_URL="file:./prisma/dev.backup-before-postgres.db"

# Prefer absolute path on NetAngels if relative fails:
# SQLITE_DATABASE_URL="file:/home/c502756/adaptedrussia.ru/app/server/prisma/dev.db"

# PostgreSQL target on NetAngels (paste your real URL locally / on server only)
POSTGRES_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Optional: skip baseline check if your SQLite snapshot differs from the
# hardcoded NetAngels expected counts (PG vs SQLite is ALWAYS enforced).
# SKIP_EXPECTED_COUNT_CHECK=1
